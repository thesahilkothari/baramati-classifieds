generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AdStatus {
  PENDING
  ACTIVE
  REJECTED
  EXPIRED
  SOLD
}

enum AdType {
  FREE
  PAID
  FEATURED
  PREMIUM
}

model User {
  id         Int      @id @default(autoincrement())
  name       String?
  mobile     String   @unique
  email      String?
  isVerified Boolean  @default(false)
  role       UserRole @default(USER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ads               Ad[]
  policyAcceptances PolicyAcceptance[]
  consentRecords    ConsentRecord[]
}

model Otp {
  id        Int      @id @default(autoincrement())
  mobile    String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Category {
  id        Int      @id @default(autoincrement())
  nameEn    String
  nameMr    String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())

  ads       Ad[]
}

model City {
  id        Int     @id @default(autoincrement())
  name      String
  slug      String  @unique
  state     String  @default("Maharashtra")
  latitude  Float?
  longitude Float?

  ads       Ad[]
}

model Ad {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String   @db.Text
  price       Decimal? @db.Decimal(12, 2)
  mobile      String
  whatsapp    String?
  address     String?
  latitude    Float?
  longitude   Float?

  status      AdStatus @default(PENDING)
  adType      AdType   @default(FREE)
  isFeatured  Boolean  @default(false)
  views       Int      @default(0)

  userId      Int
  categoryId  Int
  cityId      Int

  user        User     @relation(fields: [userId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
  city        City     @relation(fields: [cityId], references: [id])

  images            AdImage[]
  payments          Payment[]
  policyAcceptances PolicyAcceptance[]
  consentRecords    ConsentRecord[]
  reportTickets     ReportTicket[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  approvedAt          DateTime?
  expiresAt           DateTime?
  featuredUntil       DateTime?
  expiryNoticeSentAt  DateTime?
}

model AdImage {
  id       Int    @id @default(autoincrement())
  url      String
  publicId String?
  adId     Int

  ad       Ad     @relation(fields: [adId], references: [id], onDelete: Cascade)
}

model Payment {
  id                Int      @id @default(autoincrement())
  userId            Int
  adId              Int
  razorpayOrderId   String
  razorpayPaymentId String?
  razorpaySignature String?  @db.VarChar(191)
  amount            Int
  currency          String   @default("INR")
  status            String   @default("CREATED")
  plan              String?
  purpose           String?
  failureReason     String?  @db.Text
  webhookEventId    String?  @db.VarChar(191)
  verifiedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  ad                Ad       @relation(fields: [adId], references: [id])

  @@index([adId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([status])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id                Int       @id @default(autoincrement())
  provider          String    @default("RAZORPAY")
  eventId           String    @unique
  eventType         String
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentRecordId   Int?
  processed         Boolean   @default(false)
  processedAt       DateTime?
  error             String?   @db.Text
  payload           Json
  createdAt         DateTime  @default(now())

  @@index([eventType])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([processed])
  @@index([createdAt])
}

model FraudReport {
  id             Int      @id @default(autoincrement())
  adId           Int
  reason         String
  reporterMobile String?
  createdAt      DateTime @default(now())
}

model PolicyAcceptance {
  id                   Int      @id @default(autoincrement())
  userId               Int?
  adId                 Int?
  mobile               String
  name                 String?
  policyVersion        String
  effectiveDate        DateTime
  source               String   @default("POST_AD_FORM")

  acceptedTerms        Boolean  @default(false)
  acceptedPrivacy      Boolean  @default(false)
  acceptedRefund       Boolean  @default(false)
  acceptedListingRules Boolean  @default(false)
  acceptedModeration   Boolean  @default(false)

  declarations         Json?
  ipAddress            String?  @db.VarChar(191)
  userAgent            String?  @db.Text
  createdAt            DateTime @default(now())

  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ad                   Ad?      @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@index([mobile])
  @@index([adId])
  @@index([policyVersion])
  @@index([createdAt])
}

model ConsentRecord {
  id            Int      @id @default(autoincrement())
  userId        Int?
  adId          Int?
  mobile        String?
  consentType   String
  consentValue  Boolean  @default(false)
  policyVersion String?
  source        String   @default("POST_AD_FORM")
  ipAddress     String?  @db.VarChar(191)
  userAgent     String?  @db.Text
  createdAt     DateTime @default(now())

  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ad            Ad?      @relation(fields: [adId], references: [id], onDelete: SetNull)

  @@index([mobile])
  @@index([adId])
  @@index([consentType])
  @@index([createdAt])
}

model ReportTicket {
  id              Int      @id @default(autoincrement())
  referenceNumber String   @unique
  adId            Int?
  reportType      String
  reason          String   @db.VarChar(191)
  description     String   @db.Text
  pageUrl         String?  @db.Text
  evidenceUrl     String?  @db.Text

  reporterName    String?
  reporterEmail   String?
  reporterMobile  String?

  status          String   @default("NEW")
  priority        String   @default("NORMAL")
  assignedTo      String?
  resolutionNotes String?  @db.Text

  ipAddress       String?  @db.VarChar(191)
  userAgent       String?  @db.Text

  acknowledgedAt  DateTime?
  reviewedAt      DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ad              Ad?      @relation(fields: [adId], references: [id], onDelete: SetNull)
  actionLogs      ReportActionLog[]

  @@index([adId])
  @@index([reportType])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model ReportActionLog {
  id             Int      @id @default(autoincrement())
  reportTicketId Int
  action         String
  fromStatus     String?
  toStatus       String?
  note           String?  @db.Text
  actor          String?
  ipAddress      String?  @db.VarChar(191)
  userAgent      String?  @db.Text
  createdAt      DateTime @default(now())

  reportTicket   ReportTicket @relation(fields: [reportTicketId], references: [id], onDelete: Cascade)

  @@index([reportTicketId])
  @@index([createdAt])
}
